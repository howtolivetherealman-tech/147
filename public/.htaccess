# =============================================================================
# NETI BHARATHAM (నేటి భారతం) - https://netibhaaratham.com
# Official Hostinger Apache (.htaccess) Configuration File
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS on Hostinger
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Pass Authorization headers to backend APIs
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 3. Serve existing static files directly (/public/assets, /images, /icon.svg, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Proxy requests to Node.js Server on Port 3000 (if mod_proxy is enabled on Hostinger Cloud/VPS)
  <IfModule mod_proxy.c>
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>
</IfModule>

# Enable GZIP Compression for fast Telugu Font & Image delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching for Logos, Banners & News Images
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
